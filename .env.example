# Copy to .env. Secrets stay in the Python service.
APIFY_TOKEN=
APIFY_ACTOR=clockworks/tiktok-scraper
# A hard per-run spend cap, in USD. One submitted URL per run.
# This actor requires a cap of at least $0.50; the cap is not a fixed charge.
APIFY_MAX_COST_USD=0.50
# Multilingual models only: do not use an English-only .en checkpoint.
WHISPER_MODEL=small
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_DEVICE=cpu
# Provisional POC threshold; not calibrated marketing accuracy.
LAYA_MIN_CONFIDENCE=0.60
# Private, server-only URL used by the Next.js proxy.
ANALYSIS_API_URL=http://127.0.0.1:8000
# Local visual descriptions and visible text. Install with: ollama pull qwen3-vl:4b-instruct
VISION_ENABLED=true
VISION_MODEL=qwen3-vl:4b-instruct
VISION_API_URL=http://127.0.0.1:11434
# Retain original video + sampled frames locally in .data/evidence/ for review.
RETAIN_SOURCE_MEDIA=true

# Concept-level trend discovery: joint library review + independent audit, cached per revision.
# Uses the installed local model; no external API key required.
TREND_MODEL=qwen3-vl:4b-instruct
TREND_API_URL=http://127.0.0.1:11434
