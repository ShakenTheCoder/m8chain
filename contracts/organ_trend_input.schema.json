  "additionalProperties": true,
  "description": "Trend Description JSON received from the `organ` colleague.\n\nAccepts flexible field aliases (`trend_id`/`id`, `title`/`name`/`label`,\n`summary`/`description`, `records`/`videos`/`posts`/`supporting_records`)\nso integration across branches works seamlessly without brittle renames.",
  "properties": {
    "trend_id": {
      "title": "Trend Id",
      "type": "string"
    },
    "title": {
      "default": "Untitled Trend",
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "discovered_at": {
      "default": "",
      "title": "Discovered At",
      "type": "string"
    },
    "shared_elements": {
      "items": {
        "type": "string"
      },
      "title": "Shared Elements",
      "type": "array"
    },
    "dominant_features": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrendDominantFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "records": {
      "items": {
        "$ref": "#/$defs/OrganVideoRecordV1_2"
      },
      "title": "Records",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "trend_id"
  ],
  "title": "OrganTrendDescription",
  "type": "object"
}